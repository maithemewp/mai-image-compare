{
    "name": "maithemewp/mai-image-compare",
    "description": "A before/after image comparison block for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bizbudding/deployable-guard"
        }
    ],
    "authors": [
        {
            "name": "BizBudding",
            "homepage": "https://bizbudding.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "yahnis-elsts/plugin-update-checker": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mai\\ImageCompare\\": "inc/classes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "bizbudding/deployable-guard": "^1"
    },
    "scripts": {
        "install-git-hooks": [
            "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ]
    }
}
